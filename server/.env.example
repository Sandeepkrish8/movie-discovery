# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

PORT=4000

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# MongoDB Atlas connection string (added on Day 3 for the wishlist)
MONGODB_URI=

# Only needed on networks whose DNS resolver refuses SRV lookups, which breaks
# mongodb+srv:// with "querySrv ECONNREFUSED". Leave empty in production.
DNS_SERVERS=

# Where the React dev server runs, for CORS
CLIENT_ORIGIN=http://localhost:5173
